+type selectedOutBound struct {
+	Network string
+	Tag     string
+	Detour  adapter.Outbound
+}
+
+func (g *URLTestGroup) getCurrentSelectedOutBound(network string) *selectedOutBound {
+	v, ok := g.currentSelectedOutBounds.Load(network)
+	if ok {
+		return v.(*selectedOutBound)
+	}
+	return nil
+}
+
+func (g *URLTestGroup) storeCurrentSelectedOutBound(network string, detour adapter.Outbound) *selectedOutBound {
+	v := &selectedOutBound{
+		Network: network,
+		Tag:     detour.Tag(),
+		Detour:  detour,
+	}
+	g.currentSelectedOutBounds.Store(network, v)
+	return v
+}
+
+func (g *URLTestGroup) loadCache() {
+	if g.cacheLoaded {
+		return
+	}
+	cacheFile := service.FromContext[adapter.CacheFile](g.ctx)
+	if cacheFile != nil {
+		for _, network := range []string{"tcp", "udp"} {
+			selected := cacheFile.LoadURLTestSelected(g.tag, network)
+			if selected != "" {
+				for _, detour := range g.outbounds {
+					if detour.Tag() == selected {
+						g.logger.Debug("loaded from cachefile ", selected, " network: ", network)
+						g.storeCurrentSelectedOutBound(network, detour)
+						break
+					}
+				}
+			}
+		}
+	}
+	g.cacheLoaded = true
+}
