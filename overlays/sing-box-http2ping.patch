 	t = uint16(time.Since(start) / time.Millisecond)
 	return
 }
+
+var h2pool sync.Map
+
+type HTTP2Ping struct {
+	Tag       string
+	tcpConn   net.Conn
+	tlsConn   *tls.Conn
+	http2Conn *http2.ClientConn
+}
+
+func (h2 *HTTP2Ping) Destroy() {
+	if h2 == nil {
+		return
+	}
+	if h2.http2Conn != nil {
+		h2.http2Conn.Close()
+		h2.http2Conn = nil
+	}
+	if h2.tcpConn != nil {
+		h2.tcpConn.Close()
+		h2.tcpConn = nil
+	}
+	h2pool.Delete(h2.Tag)
+}
+
+func (h2 *HTTP2Ping) Ping(ctx context.Context, deadline time.Time) error {
+	h2.tlsConn.SetDeadline(deadline)
+	defer h2.tlsConn.SetDeadline(time.Time{})
+	return h2.http2Conn.Ping(ctx)
+}
+
+func getHttp2Conn(ctx context.Context, hostname, port string, detour N.Dialer, tag string) (h2 *HTTP2Ping, err error) {
+
+	v, ok := h2pool.Load(tag)
+	if !ok {
+		h2 = &HTTP2Ping{Tag: tag}
+
+		h2.tcpConn, err = detour.DialContext(ctx, "tcp", M.ParseSocksaddrHostPortStr(hostname, port))
+		if err != nil {
+			h2 = nil
+			return
+		}
+
+		h2.tlsConn = tls.Client(h2.tcpConn, &tls.Config{
+			ServerName: hostname,
+			NextProtos: []string{"h2"},
+		})
+
+		tr := http2.Transport{}
+		h2.http2Conn, err = tr.NewClientConn(h2.tlsConn)
+		if err != nil {
+			h2.Destroy()
+			h2 = nil
+			return
+		}
+
+		// FIXME close when program exit
+		h2pool.Store(tag, h2)
+	} else {
+		h2 = v.(*HTTP2Ping)
+	}
+
+	return h2, nil
+}
+
+func URLTestH2(ctx context.Context, link string, detour N.Dialer, tag string, interval time.Duration) (t uint16, err error) {
+	if link == "" {
+		link = "https://1.1.1.1"
+	}
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return
+	}
+	hostname := linkURL.Hostname()
+	port := linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "https":
+			port = "443"
+		default:
+			err = fmt.Errorf("wrong protocol scheme: %s", linkURL.Scheme)
+			return
+		}
+	}
+
+	// FIXME limit creations with frequent failures
+	h2, err := getHttp2Conn(ctx, hostname, port, detour, tag)
+	if err != nil {
+		return
+	}
+
+	start := time.Now()
+	err = h2.Ping(ctx, start.Add(interval))
+	if err != nil {
+		h2.Destroy()
+		return
+	}
+	return uint16(time.Since(start) / time.Millisecond), nil
+
+}
