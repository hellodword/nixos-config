diff --git a/patch.md b/patch.md
new file mode 100644
index 0000000..f0f16db
--- /dev/null
+++ b/patch.md
@@ -0,0 +1,3 @@
+AdGuard Home caches SERVFAIL responses, but this doesn't suit my use case. Patching AdGuard Home and dnsproxy is quite complex, so instead, I chose to patch its upstream, MosDNS, to modify SERVFAIL responses and override the cache TTL to one second.
+
+- https://github.com/AdguardTeam/dnsproxy/blob/11779165dd116c8889cf6dca9675607f83ed2502/proxy/cache.go#L445-L503
diff --git a/pkg/server_handler/entry_handler.go b/pkg/server_handler/entry_handler.go
index c30fcd7..7ef6708 100644
--- a/pkg/server_handler/entry_handler.go
+++ b/pkg/server_handler/entry_handler.go
@@ -24,6 +24,7 @@ import (
 	"time"
 
 	"github.com/IrineSistiana/mosdns/v5/mlog"
+	"github.com/IrineSistiana/mosdns/v5/pkg/dnsutils"
 	"github.com/IrineSistiana/mosdns/v5/pkg/query_context"
 	"github.com/IrineSistiana/mosdns/v5/pkg/server"
 	"github.com/IrineSistiana/mosdns/v5/pkg/utils"
@@ -104,6 +105,7 @@ func (h *EntryHandler) Handle(ctx context.Context, q *dns.Msg, serverMeta server
 		resp = new(dns.Msg)
 		resp.SetReply(q)
 		resp.Rcode = dns.RcodeServerFailure
+		dnsutils.ApplyMinimalTTL(resp, 1)
 	} else {
 		resp = qCtx.R()
 	}
