{
  "keybindings": [
    {
      "command": "workbench.action.closeWindow",
      "key": "ctrl+q"
    },
    {
      "command": "-markdown-preview-enhanced.openPreview",
      "key": "ctrl+shift+v"
    },
    {
      "command": "-markdown.togglePreview",
      "key": "ctrl+shift+v"
    },
    {
      "command": "-notebook.cell.pasteAbove",
      "key": "ctrl+shift+v"
    }
  ],
  "userSettings": {
    "chat.agent.enabled": false,
    "chat.commandCenter.enabled": false,
    "chat.detectParticipant.enabled": false,
    "chat.disableAIFeatures": true,
    "chat.edits2.enabled": false,
    "chat.extensionTools.enabled": false,
    "chat.implicitContext.enabled": {
      "editing-session": "never",
      "panel": "never"
    },
    "chat.mcp.access": "none",
    "chat.mcp.discovery.enabled": {
      "claude-desktop": false,
      "cursor-global": false,
      "cursor-workspace": false,
      "windsurf": false
    },
    "diffEditor.wordWrap": "on",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Sarasa Term SC', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 15,
    "editor.fontWeight": "normal",
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.letterSpacing": 0,
    "editor.lineHeight": 0,
    "editor.wordWrap": "on",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "extensions.ignoreRecommendations": true,
    "files.eol": "\n",
    "git.enableCommitSigning": false,
    "git.enableSmartCommit": false,
    "git.enableStatusBarSync": false,
    "git.enabled": true,
    "git.openRepositoryInParentFolders": "always",
    "github.branchProtection": false,
    "github.gitAuthentication": false,
    "github.showAvatar": false,
    "remote.autoForwardPortsSource": "hybrid",
    "telemetry.enableTelemetry": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'Sarasa Term SC', monospace",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.letterSpacing": 0,
    "terminal.integrated.lineHeight": 1,
    "update.mode": "none",
    "window.titleBarStyle": "custom",
    "workbench.localHistory.enabled": false
  }
}
